# WhatsApp Business Cloud API credentials. Keep this file private; never commit backend/safety/.env.
# Create a Meta WhatsApp Business app and use a registered business phone number.
WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id

# Must exactly match an approved utility template in WhatsApp Manager.
# Template body must contain two text placeholders: {{1}} for the time slot, {{2}} for medicine list.
WHATSAPP_TEMPLATE_NAME=carelekha_daily_medicine_reminder
WHATSAPP_TEMPLATE_LANGUAGE=ml
WHATSAPP_GRAPH_API_VERSION=v23.0
